{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/repositories/*": ["./src/repositories/*"],
      "@/prisma/*": ["./src/prisma/*"],
      "@edu-platform/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["src/**/*", "../../packages/core/src/**/*"],
  "exclude": ["node_modules", "dist", "src/generated"]
}