generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  providerId    String?   @unique
  name          String
  email         String    @unique
  role          UserRole  @default(USER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  checklists    Checklist[]
  performedRoleAuditLogs UserRoleAuditLog[] @relation("UserRoleAuditActor")
  receivedRoleAuditLogs  UserRoleAuditLog[] @relation("UserRoleAuditTarget")

  @@map("users")
}

model UserRoleAuditLog {
  id           Int      @id @default(autoincrement())
  actorUserId  String   @db.Uuid
  targetUserId String   @db.Uuid
  previousRole UserRole
  newRole      UserRole
  createdAt    DateTime @default(now())
  actor        User     @relation("UserRoleAuditActor", fields: [actorUserId], references: [id], onDelete: NoAction)
  target       User     @relation("UserRoleAuditTarget", fields: [targetUserId], references: [id], onDelete: NoAction)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("user_role_audit_logs")
}

model Checklist {
  id        Int      @id @default(autoincrement())
  userId    String   @db.Uuid
  contentId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, contentId])
  @@map("checklists")
}

model Series {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  subjects  Subject[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("series")
}

model Subject {
  id                 Int                 @id @default(autoincrement())
  name               String
  description        String?
  imageUrl           String?
  order              Int                 @default(0)
  seriesId           Int?
  series             Series?             @relation(fields: [seriesId], references: [id])
  topicSubjects      TopicSubject[]
  vestibularSubjects VestibularSubject[]
  vestibularTopics   VestibularTopic[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("subjects")
}

model Topic {
  id                          Int                          @id @default(autoincrement())
  name                        String
  contents                    Content[]
  topicSubjects               TopicSubject[]
  accessibilityCategoryTopics AccessibilityCategoryTopic[]
  vestibularTopics            VestibularTopic[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  @@map("topics")
}

model Content {
  id                 Int                 @id @default(autoincrement())
  title              String
  description        String?
  type               String
  link               String
  thumbnailUrl       String
  videoUrl           String?
  pdfUrl             String?
  transcript         String?
  captionsUrl        String?
  librasUrl          String?
  audioDescriptionUrl String?
  order              Int                 @default(0)
  topicId            Int
  topic              Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  checklists         Checklist[]
  vestibularContents VestibularContent[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("contents")
}

model TopicSubject {
  topicId   Int
  subjectId Int
  topic     Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([topicId, subjectId])
  @@map("topic_subjects")
}

model Vestibular {
  id                 Int                 @id @default(autoincrement())
  name               String
  description        String?
  year               Int?
  imageUrl           String?
  vestibularSubjects VestibularSubject[]
  vestibularContents VestibularContent[]
  vestibularTopics   VestibularTopic[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("vestibulares")
  @@unique([name, year])
}

model VestibularSubject {
  vestibularId Int
  subjectId    Int
  vestibular   Vestibular @relation(fields: [vestibularId], references: [id], onDelete: Cascade)
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([vestibularId, subjectId])
  @@map("vestibular_subjects")
}

model VestibularContent {
  id                Int        @id @default(autoincrement())
  vestibularId      Int
  vestibularTopicId Int?
  title             String
  type              String?
  link              String?
  pdfUrl            String?
  transcript        String?
  captionsUrl       String?
  librasUrl         String?
  audioDescriptionUrl String?
  isShared          Boolean    @default(false)
  originalContentId Int?
  vestibular        Vestibular @relation(fields: [vestibularId], references: [id], onDelete: Cascade)
  vestibularTopic   VestibularTopic? @relation(fields: [vestibularTopicId], references: [id], onDelete: Cascade)
  originalContent   Content?   @relation(fields: [originalContentId], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("vestibular_contents")
  @@index([vestibularId, vestibularTopicId])
}

model VestibularTopic {
  id              Int        @id @default(autoincrement())
  vestibularId    Int
  subjectId       Int?
  name            String
  originalTopicId Int?
  isShared        Boolean    @default(false)
  notes           String?
  tags            String?
  vestibular      Vestibular @relation(fields: [vestibularId], references: [id], onDelete: Cascade)
  subject         Subject?   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  originalTopic   Topic?     @relation(fields: [originalTopicId], references: [id])
  contents        VestibularContent[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("vestibular_topics")
  @@index([vestibularId, subjectId])
}

model PracticalCategory {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  slug        String           @unique
  icon        String?
  order       Int              @default(0)
  guides      PracticalGuide[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([order, name])
  @@map("practical_categories")
}

model PracticalGuide {
  id                  Int                  @id @default(autoincrement())
  practicalCategoryId Int
  title               String
  summary             String
  content             String
  slug                String               @unique
  order               Int                  @default(0)
  isPublished         Boolean              @default(false)
  category            PracticalCategory    @relation(fields: [practicalCategoryId], references: [id], onDelete: Cascade)
  links               PracticalGuideLink[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([practicalCategoryId, order, title])
  @@index([isPublished, order])
  @@map("practical_guides")
}

model PracticalGuideLink {
  id               Int            @id @default(autoincrement())
  practicalGuideId Int
  label            String
  url              String
  order            Int            @default(0)
  guide            PracticalGuide @relation(fields: [practicalGuideId], references: [id], onDelete: Cascade)

  @@index([practicalGuideId, order, label])
  @@map("practical_guide_links")
}

model AccessibilityCategory {
  id             Int                        @id @default(autoincrement())
  name           String                     @unique
  description    String?
  categoryTopics AccessibilityCategoryTopic[]
  needs          AccessibilityNeed[]
  themes         AccessibilityTheme[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@map("accessibility_categories")
}

model AccessibilityCategoryTopic {
  accessibilityCategoryId Int
  topicId                 Int
  accessibilityCategory   AccessibilityCategory @relation(fields: [accessibilityCategoryId], references: [id], onDelete: Cascade)
  topic                   Topic                 @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([accessibilityCategoryId, topicId])
  @@map("accessibility_category_topics")
}

model AccessibilityNeed {
  id                      Int                   @id @default(autoincrement())
  accessibilityCategoryId Int
  name                    String
  accessibilityCategory   AccessibilityCategory @relation(fields: [accessibilityCategoryId], references: [id], onDelete: Cascade)
  themes                  AccessibilityTheme[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@map("accessibility_needs")
}

model AccessibilityTheme {
  id                      Int                   @id @default(autoincrement())
  accessibilityCategoryId Int
  accessibilityNeedId     Int?
  title                   String
  content                 String?
  accessibilityCategory   AccessibilityCategory @relation(fields: [accessibilityCategoryId], references: [id], onDelete: Cascade)
  accessibilityNeed       AccessibilityNeed?    @relation(fields: [accessibilityNeedId], references: [id])
  materials               AccessibilityThemeMaterial[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@map("accessibility_themes")
  @@unique([accessibilityCategoryId, title])
}

model AccessibilityThemeMaterial {
  id                   Int                @id @default(autoincrement())
  accessibilityThemeId Int
  title                String
  summary              String
  content              String
  type                 String
  link                 String
  order                Int                @default(0)
  theme                AccessibilityTheme @relation(fields: [accessibilityThemeId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([accessibilityThemeId, order, title])
  @@map("accessibility_theme_materials")
}
