{
  "name": "edu-platform",
  "version": "1.0.0",
  "packageManager": "npm@10.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "npm run test:core && npm run test:infrastructure",
    "test:core": "node --test --experimental-transform-types --experimental-specifier-resolution=node \"packages/core/src/**/*.test.ts\"",
    "test:infrastructure": "node --test --experimental-transform-types --experimental-specifier-resolution=node \"packages/infrastructure/src/**/*.test.ts\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.4.1",
    "postcss": "^8.5.9",
    "prettier": "^3.1.1",
    "prisma": "^7.7.0",
    "tailwindcss": "^4.2.2",
    "turbo": "^2.9.3"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "lucide-react": "^1.8.0",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.20.0",
    "react-hook-form": "^7.72.1",
    "zod": "^4.3.6"
  }
}
