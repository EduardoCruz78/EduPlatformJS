{
  "name": "edu-platform",
  "version": "1.0.0",
  "packageManager": "npm@10.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "npm run lint --workspace web",
    "typecheck": "npm run prisma:generate && npm run typecheck:core && npm run typecheck:infrastructure && npm run typecheck:web",
    "typecheck:core": "npx tsc -p packages/core/tsconfig.json --noEmit",
    "typecheck:infrastructure": "npx tsc -p packages/infrastructure/tsconfig.json --noEmit",
    "typecheck:web": "npx tsc -p apps/web/tsconfig.json --noEmit",
    "test": "npm run test:architecture && npm run test:core && npm run test:infrastructure && npm run test:web",
    "test:architecture": "node --test \"tests/**/*.test.mjs\"",
    "test:core": "node --test --experimental-transform-types --experimental-specifier-resolution=node \"packages/core/src/**/*.test.ts\"",
    "test:infrastructure": "node --test --experimental-transform-types --experimental-specifier-resolution=node \"packages/infrastructure/src/**/*.test.ts\"",
    "test:web": "vitest run --config apps/web/vitest.config.ts",
    "prisma:generate": "prisma generate",
    "db:seed": "node --experimental-transform-types --experimental-specifier-resolution=node prisma/seed.ts",
    "import:curriculum:pdf": "node --experimental-transform-types --experimental-specifier-resolution=node prisma/import-series-pdf.ts",
    "sync:first-grade:bncc": "node --experimental-transform-types --experimental-specifier-resolution=node prisma/sync-first-grade-bncc.ts",
    "audit:full": "npm audit",
    "audit:prod": "npm audit --omit=dev",
    "clean": "turbo run clean && rimraf node_modules apps/*/node_modules packages/*/node_modules .turbo apps/*/.next",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.4.1",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.13",
    "prettier": "^3.1.1",
    "prisma": "^7.7.0",
    "rimraf": "^6.1.0",
    "tailwindcss": "^4.2.2",
    "turbo": "^2.9.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "lucide-react": "^1.8.0",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.20.0",
    "react-hook-form": "^7.72.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "@expo/metro-config": {
      "postcss": "8.5.13"
    },
    "next": {
      "postcss": "8.5.13"
    },
    "xcode": {
      "uuid": "14.0.0"
    }
  }
}
